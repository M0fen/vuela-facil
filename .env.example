# Vuela Fácil — variables de entorno. Copia este archivo como `.env.local`
# y rellena los valores. NO subas `.env.local` al repositorio.

# --- Básico -----------------------------------------------------------------
# Número de WhatsApp del negocio (formato internacional sin + ni espacios).
NEXT_PUBLIC_WHATSAPP_NUMERO=573114494224
# Dominio público del sitio, SIN slash final (se usa en el redirect de pagos).
NEXT_PUBLIC_SITE_URL=https://vuelafacil.com

# --- Asistente IA (DeepSeek) ------------------------------------------------
DEEPSEEK_API_KEY=

# --- Vercel Blob (datos + imágenes) -----------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Panel de administración ------------------------------------------------
ADMIN_PASSWORD=
AUTH_SECRET=

# --- Pagos: Wompi (OPCIONAL) -------------------------------------------------
# Al configurar estas tres variables se ACTIVA el pago online ("Separa con el
# 30%") en el modal de paquete. Sin ellas, el sitio funciona 100% por WhatsApp.
#   1) Crea cuenta de comercio en Wompi (https://comercios.wompi.co).
#   2) Copia la llave pública y los secretos de Integridad y de Eventos.
#   3) Configura la URL del webhook en el panel de Wompi:
#        https://TU-DOMINIO/api/pagos/wompi/webhook
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Notificaciones por correo: Resend (OPCIONAL) ----------------------------
# Al configurar RESEND_API_KEY + NOTIFY_EMAIL, el asesor recibe un correo por
# cada lead y cada reserva. Sin ellas, no se envía nada (el sitio funciona igual).
#   1) Crea cuenta en https://resend.com y copia tu API key.
#   2) NOTIFY_EMAIL = correo donde quieres recibir los avisos.
#   3) NOTIFY_FROM (opcional) = remitente verificado; por defecto usa el dominio
#      de pruebas de Resend (onboarding@resend.dev).
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
